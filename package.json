{
  "name": "argentbank",
  "version": "2.0.0",
  "description": "Argent Bank financial dashboard",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "podman compose up -d --wait mongo && concurrently \"pnpm dev\" \"pnpm --filter argent-bank-api dev:server\" \"pnpm --filter argent-bank-api populate-db\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src && stylelint \"src/**/*.{css,scss}\"",
    "fix": "eslint src --fix && prettier --write .",
    "check": "tsc --noEmit && pnpm lint && prettier --check ."
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "24",
        "onFail": "download"
      }
    ]
  }
}
